NEXT_PUBLIC_API_URL=http://localhost:3001
# URL pública del frontend (sitemap/robots/canonicals SEO de las landings).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secreto compartido con la API para revalidar la web pública del tenant al
# cambiar su plantilla/textos (mismo valor que REVALIDATE_SECRET de la API).
REVALIDATE_SECRET=
# Solo servidor (opcionales): el web llama al API por la red interna y con el
# token compartido para no contar en los límites por IP (mismo valor que el API).
# INTERNAL_API_URL=http://api:3001
# INTERNAL_API_TOKEN=
